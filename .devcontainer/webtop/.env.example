# Use the profile setup in README.md to create a private .env.
# WEBTOP_PROJECT_NAME and WEBTOP_WORKSPACE_DIR are checkout-specific.
# WEBTOP_IMAGE=ghcr.io/joshyorko/webtop-os:latest
WEBTOP_HTTP_PORT=13000
WEBTOP_HTTPS_PORT=13001
WEBTOP_USER=kdlocpanda
WEBTOP_GIT_NAME=joshyorko
WEBTOP_GIT_EMAIL=joshyorko@users.noreply.github.com
WEBTOP_MICROPHONE_ENABLED=false
# GPU-less VM with VKMS: select its card device and enable Mesa software rendering.
# WEBTOP_RENDER_NODE=/dev/dri/card1
# WEBTOP_SOFTWARE_RENDERING=1
