{
    "name": "Room of Requirement - Review Lab",
    "image": "ghcr.io/joshyorko/room-of-requirement:wolfi",
    "remoteUser": "vscode",
    "privileged": true,
    "overrideCommand": false,
    "mounts": [
        "source=ror-codex-vscode-home-${devcontainerId},target=/home/vscode,type=volume"
    ],
    "containerEnv": {
        "DEV_CONTAINERS_SKIP_GCOMPAT_INSTALL": "true",
        "HOMEBREW_NO_ANALYTICS": "1",
        "REVIEW_UPSTREAM_REF": "main",
        // Optional Headroom setting from the reference configuration; disabled for now.
        // "HEADROOM_BASE_URL": "http://10.10.10.89/v1",
        "BLUEFIN_REVIEW_INHERIT_OMP_CONFIG": "1",
        "LUNA_FACTORY_ENABLED": "1",
        "LUNA_FACTORY_CAPACITY": "2"
    },
    "remoteEnv": {
        "SHELL": "/bin/zsh",
        "HOMEBREW_NO_ANALYTICS": "1"
    },
    "postCreateCommand": [
        "/bin/bash",
        "${containerWorkspaceFolder}/.devcontainer/scripts/bootstrap-review.sh"
    ],
    "postAttachCommand": [
        "/bin/sh",
        "${containerWorkspaceFolder}/.vscode/install-josh-room.sh"
    ]
}